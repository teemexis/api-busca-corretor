PORT=8000
DISPLAY=:99
DOCKER=true
PLAYWRIGHT_HEADLESS=false
SCRAPER_MAX_ATTEMPTS=3

# CapSolver (recomendado na VPS): https://www.capsolver.com
CAPSOLVER_API_KEY=sua_chave_capsolver

# Alternativa: 2Captcha
# TWOCAPTCHA_API_KEY=sua_chave_2captcha

# Opcional: proxy residencial para Playwright sem 2Captcha
# PLAYWRIGHT_PROXY=http://usuario:senha@host:porta
