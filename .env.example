PORT=8000
DISPLAY=:99
DOCKER=true
PLAYWRIGHT_HEADLESS=false
SCRAPER_MAX_ATTEMPTS=3

# Obrigatorio na VPS (IP de datacenter): chave da https://2captcha.com
TWOCAPTCHA_API_KEY=sua_chave_aqui

# Opcional: proxy residencial para Playwright sem 2Captcha
# PLAYWRIGHT_PROXY=http://usuario:senha@host:porta
